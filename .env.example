# Family OS 통합 배포 .env 예시 — 복사해 .env 로 사용 (.env 는 커밋 금지)
# 설계 근거: scratchpad/deploy-integration-plan.md, phase-drafts.md
# 시크릿 생성 예: openssl rand -hex 32

# --- DB (기존 mysql-server-v2 재사용, family_os 스키마) ---
DB_HOST=mysql-server-v2
DB_PORT=3306
DB_NAME=family_os
DB_USER=family_os
DB_PASSWORD=change-me

# --- JWT (HS256, 각 32바이트+) ---
JWT_ACCESS_SECRET=change-me-access-32b+
JWT_REFRESH_SECRET=change-me-refresh-32b+

# --- CORS (웹 도메인) ---
CORS_ALLOWED_ORIGINS=https://your-ledger-domain.example.com

# --- 프론트 웹 빌드 API base (expo export 시 주입) ---
EXPO_PUBLIC_API_BASE_URL=https://your-ledger-domain.example.com/api/v1

# --- 스토리지 (외장 SSD 볼륨 마운트 경로) ---
STORAGE_LOCAL_ROOT=/data/photos
STORAGE_URL_SECRET=change-me-storage-32b+

# --- Hermes 내부 API 서비스 토큰 (api ↔ family-os-mcp 동일값) ---
HERMES_SERVICE_TOKEN=change-me-service-token-32b+
FAMILYOS_SERVICE_TOKEN=change-me-service-token-32b+

# --- 최초 부트스트랩 (DB 비었을 때만 1회 시드) ---
BOOTSTRAP_ENABLED=true
BOOTSTRAP_LOGIN_ID=admin
BOOTSTRAP_PASSWORD=change-me-initial
BOOTSTRAP_PARENT_NAME=부모
BOOTSTRAP_FAMILY_NAME=우리 가족
BOOTSTRAP_TIMEZONE=Asia/Seoul

# --- 구글 캘린더: 1차 비활성 ---
GOOGLE_PUSH_ENABLED=false
